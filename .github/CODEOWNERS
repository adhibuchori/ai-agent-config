# Requests reviewers automatically. Without branch protection this is a prompt, not
# a gate. Later rules win, so the narrow entries below override the catch-all.

*                                @your-github-handle

# Anything that decides what reaches production deserves a deliberate look.
/.github/workflows/              @your-github-handle
/.github/dependabot.yml          @your-github-handle
/.gitleaks.toml                  @your-github-handle
/Dockerfile                      @your-github-handle

# The composition root, the env schema, and the one real connection pool: a
# mistake in any of these breaks startup or serializes every request.
/src/app/main.py                 @your-github-handle
/src/app/core/config.py          @your-github-handle
/src/app/db/session.py           @your-github-handle

# If Rule 13 applies: the cross-repo schema mirror. A hand-edit here that
# doesn't match the schema owner's copy breaks queries silently.
/src/app/db/models.py            @your-github-handle

# Alembic-generated, if this repo owns its schema — never hand-edited.
/src/app/db/migrations/          @your-github-handle
